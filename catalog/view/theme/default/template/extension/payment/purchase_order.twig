<h4>{{ text_instruction }}</h4>
  <div class="well well-sm">
    <div>
      <label>{{ entry_po_number }}</label>
      <input type="text" id="po_number" name="po_number" value="" />
    </div>
  </div>
  <div class="buttons">
    <div class="pull-right">
      <input type="button" value="{{ button_confirm }}" id="button-confirm" class="btn btn-primary" data-loading-text="{{ text_loading }}" />
    </div>
  </div>
<script type="text/javascript"><!--
$('#button-confirm').on('click', function() {
	var valid_po = /^[0-9a-zA-Z]+$/;
	var invalid_po = /^(?![0-9a-zA-Z ]+$)/;
	
	{% if (required == 'true') %}
		if ($('#po_number').val().length == 0){
			alert('{{ error_blank_po_number }}');
			('#po_number').focus();
			return false;
		} else if ($('#po_number').val().match(invalid_po)){
			alert('{{ error_invalid_po_number }}');
			('#po_number').focus();
			return false;
		}
	{% endif %}
	
	$.ajax({
		type: 'POST',
		url: 'index.php?route=extension/payment/purchase_order/confirm',
		dataType: 'text',
		data: $('#po_number'),
		success: function() {
			location = '{{ continue }}';
		},
		error: function(xhr, ajaxOptions, thrownError) {
			alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
		}
	});
});
//--></script>
